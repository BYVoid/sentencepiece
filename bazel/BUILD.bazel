load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# The SentencePiece sources include their third-party headers with a
# "third_party/..." prefix. The CMake build satisfies those includes with
# checkouts or vendored copies under third_party/; here they are forwarded
# to the corresponding Bazel Central Registry modules through the headers
# generated by @include_compat (see include_compat.bzl).
#
# This aggregate target mirrors the SPM_LIBS list in src/CMakeLists.txt plus
# the header-only Abseil libraries the sources include directly.
cc_library(
    name = "absl",
    # //absl/base:endian (for base/internal/endian.h, used by src/util.h) is
    # intentionally absent: it is not publicly visible. Its header still
    # reaches dependents through the transitive headers of //absl/strings.
    deps = [
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/cleanup",
        "@com_google_absl//absl/container:btree",
        "@com_google_absl//absl/container:fixed_array",
        "@com_google_absl//absl/container:flat_hash_map",
        "@com_google_absl//absl/container:flat_hash_set",
        "@com_google_absl//absl/flags:config",
        "@com_google_absl//absl/flags:flag",
        "@com_google_absl//absl/flags:parse",
        "@com_google_absl//absl/flags:usage",
        "@com_google_absl//absl/functional:any_invocable",
        "@com_google_absl//absl/functional:function_ref",
        "@com_google_absl//absl/hash",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/log:check",
        "@com_google_absl//absl/log:flags",
        "@com_google_absl//absl/log:globals",
        "@com_google_absl//absl/log:initialize",
        "@com_google_absl//absl/numeric:bits",
        "@com_google_absl//absl/random",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_builder",
        "@com_google_absl//absl/status:status_macros",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:str_format",
        "@com_google_absl//absl/synchronization",
        "@com_google_absl//absl/time",
        "@com_google_absl//absl/types:span",
        "@include_compat//:headers",
    ],
)

# Upstream darts-clone from the Bazel Central Registry, reachable through
# the "darts_clone/darts.h" include path used by the sources. The vendored
# copy under third_party/darts_clone is only used by CMake.
cc_library(
    name = "darts_clone",
    deps = [
        "@darts_clone//:darts-clone",
        "@include_compat//:headers",
    ],
)
