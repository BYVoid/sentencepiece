load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# The vendored darts_clone/ and protobuf-lite/ copies are only used by the
# CMake build. The Bazel build takes darts-clone and protobuf from the Bazel
# Central Registry instead (see //bazel:darts_clone and //src:pb).
cc_library(
    name = "esaxx",
    hdrs = [
        "esaxx/esa.hxx",
        "esaxx/sais.hxx",
    ],
)
